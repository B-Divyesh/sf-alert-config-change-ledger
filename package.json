{
  "name": "alert-config-change-ledger-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.ts",
    "build": "cargo build --release && npm run build:site",
    "build:site": "vite build --config site/vite.config.ts && node site/scripts/build-sw.mjs",
    "deploy": "npm run build && swa deploy production --env production",
    "deploy:check": "npm run build && swa deploy production --env production --dry-run",
    "preview": "vite preview --config site/vite.config.ts",
    "pretest": "node site/scripts/ensure-test-deps.mjs",
    "test": "cargo test && npm run test:api && npm run test:scripts && playwright test",
    "test:claims-clean": "node site/scripts/test-clean-claims.mjs",
    "test:api": "node --test api/**/*.test.cjs",
    "test:scripts": "node --test site/scripts/*.test.mjs",
    "test:claim:minimum-runtimes": "node site/scripts/check-minimum-runtimes.mjs",
    "test:claim:build-artifacts": "node site/scripts/verify-build-artifacts.mjs",
    "pretest:claim:pro-pack-contents": "node site/scripts/ensure-test-deps.mjs",
    "test:claim:pro-pack-contents": "node --test --test-name-pattern=@claim:pro-pack-contents api/approval-pack/index.test.cjs",
    "test:site": "playwright test",
    "typecheck": "tsc --noEmit -p site/tsconfig.json",
    "lint": "cargo fmt --all -- --check && cargo clippy --all-targets --all-features -- -D warnings && npm run typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vite": "^7.3.6"
  }
}
